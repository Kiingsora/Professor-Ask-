{
  "manifest_version": 3,
  "name": "Professor Ask",
  "version": "0.9.5",
  "description": "Discuss YouTube videos with Codex or Google Antigravity using timestamped transcript context.",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/backend-api/codex/*"
  ],
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Ouvrir les paramètres Professor Ask"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/transcript/youtube-panel-main.js",
        "content/transcript/youtube-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/core.js",
        "content/history.js",
        "content/transcript/youtube.js",
        "content/transcript/status.js",
        "content/transcript/manager.js",
        "content/transcript/preview.js",
        "content/ui.js",
        "content/chat.js",
        "content/app.js"
      ],
      "css": ["content/style.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "professor-ask@kiingsora.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personalCommunications", "websiteContent"]
      }
    }
  }
}
