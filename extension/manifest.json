{
  "manifest_version": 3,
  "name": "Professor Ask",
  "version": "0.6.1",
  "description": "Discuss YouTube videos with Codex or Google Antigravity using timestamped transcript context.",
  "key": "",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/backend-api/codex/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ouvrir les paramètres Professor Ask"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
