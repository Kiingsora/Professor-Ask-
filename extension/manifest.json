{
  "manifest_version": 3,
  "name": "Professor Ask",
  "version": "0.8.1",
  "description": "Discuss YouTube videos with Codex or Google Antigravity using timestamped transcript context.",
  "key": "",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/backend-api/codex/*",
    "http://127.0.0.1:43120/*",
    "http://localhost:43120/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ouvrir les paramètres Professor Ask"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/core.js",
        "content/history.js",
        "content/transcript/youtube.js",
        "content/transcript/remote.js",
        "content/transcript/status.js",
        "content/transcript/manager.js",
        "content/transcript/preview.js",
        "content/ui.js",
        "content/chat.js",
        "content/app.js"
      ],
      "css": ["content/style.css"],
      "run_at": "document_idle"
    }
  ]
}
