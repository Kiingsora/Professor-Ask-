{
  "manifest_version": 3,
  "name": "Professor Ask",
  "version": "0.10.0",
  "description": "Discuss YouTube videos with ChatGPT/Codex or your own AI provider API key using timestamped transcript context.",
  "key": "",
  "icons": {
    "16": "icons/professor-ask.png",
    "32": "icons/professor-ask.png",
    "48": "icons/professor-ask.png",
    "128": "icons/professor-ask.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/backend-api/codex/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.mistral.ai/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ouvrir les paramètres Professor Ask",
    "default_icon": {
      "16": "icons/professor-ask.png",
      "32": "icons/professor-ask.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/transcript/youtube-panel-main.js",
        "content/transcript/youtube-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/core.js",
        "content/history.js",
        "content/transcript/youtube.js",
        "content/transcript/status.js",
        "content/transcript/manager.js",
        "content/transcript/preview.js",
        "content/answer.js",
        "content/ui.js",
        "content/chat.js",
        "content/app.js"
      ],
      "css": ["content/style.css"],
      "run_at": "document_idle"
    }
  ]
}
