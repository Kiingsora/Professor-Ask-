{
  "manifest_version": 3,
  "name": "Professor Ask",
  "version": "0.1.0",
  "description": "Discuss YouTube videos with Codex using timestamped transcript context.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:43119/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
